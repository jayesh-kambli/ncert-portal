DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncert_portal
OPENAI_API_KEY=

# Port the app listens on in production (see DEPLOYMENT.md). Not used in
# local dev — `next dev` always uses 3000.
PORT=4055

# OpenAI credit balance shown on the dashboard (optional — hidden if
# OPENAI_ADMIN_KEY is unset). OpenAI has no balance API, so remaining =
# OPENAI_CREDIT_TOTAL (USD purchased) minus spend since OPENAI_CREDIT_SINCE
# (first top-up, YYYY-MM-DD); without those two it shows this month's spend.
# OPENAI_ADMIN_KEY is an org Admin key (sk-admin-...) — server-side only.
OPENAI_ADMIN_KEY=
OPENAI_CREDIT_TOTAL=
OPENAI_CREDIT_SINCE=
